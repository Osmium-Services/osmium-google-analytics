{
    "id": "google-analytics",
    "name": "Google Analytics",
    "version": "2.0.3",
    "description": "Google Tag Manager / GA4 loading with Consent Mode v2, gated on an admin-editable toggle and production-only; requires the Cookie Consent service",
    "category": "marketing-analytics",
    "author": {
        "name": "Gavin Cox"
    },
    "license": "proprietary",

    "requires": {
        "osmium": ">=1.0.0",
        "php": ">=8.1",
        "services": ["cookie-consent"]
    },

    "autoload": [
        "models"
    ],

    "csp": {
        "script-src": ["https://www.googletagmanager.com"],
        "connect-src": ["https://www.google-analytics.com", "https://*.google-analytics.com", "https://*.analytics.google.com"],
        "frame-src": ["https://www.googletagmanager.com"]
    },

    "admin": {
        "menu": {
            "section": "Content",
            "items": [
                {
                    "id": "google-analytics",
                    "label": "Google Analytics",
                    "icon": "bx bx-bar-chart-alt-2",
                    "route": "admin/settings/google-analytics",
                    "activePattern": "admin/settings/google-analytics",
                    "role": null
                }
            ]
        },
        "routes": {
            "admin/settings/google-analytics": {
                "controller": "controllers/GoogleAnalyticsController.php",
                "class": "Osmium\\Services\\GoogleAnalytics\\Controllers\\GoogleAnalyticsController",
                "method": "index",
                "title": "Google Analytics"
            }
        }
    },

    "frontend": {
        "themeBlocks": [
            {
                "hook": "head",
                "file": "theme/analytics-headscript.phtml"
            }
        ]
    },

    "setup": {
        "postInstallNote": "Disabled by default. A theme must call ServiceThemeBlocks::render('head', ['googleAnalytics' => ..., 'site' => $site]) in its <head> template before enabling this does anything visible."
    }
}
