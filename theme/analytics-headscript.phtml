<?php // Included via ServiceThemeBlocks::render('head', [...]) by a real theme's
// own <head> template - see that class's doc comment. Expects $googleAnalytics
// (this service's own config, e.g. ['enabled' => bool, 'gtmId' => string])
// and $site (for the environment check) in the render context - nothing
// else. This service requires Cookie Consent to be installed (service.json
// requires.services), but has no PHP-level coupling to it: it reads a
// documented client-side convention - window.OsmiumCookieConsent.cookieName
// and the 'osmium:consent' event - so no consent class is referenced here.
// See the runtime JS below for the actual contract. ?>
<?php
$analyticsEnabled = $googleAnalytics['enabled'] ?? false;
$isProduction = !\in_array($site['environment'] ?? '', ['dev', 'staging'], true);
$gtmId = (string) ($googleAnalytics['gtmId'] ?? '');
$gtmIdValid = \preg_match(pattern: '/^GTM-[A-Z0-9]{4,12}$/', subject: $gtmId) === 1; // Same rule as GoogleAnalyticsConfig::isValidGtmId()
$shouldLoad = $analyticsEnabled && $gtmIdValid && $isProduction; // GA4/GTM only on production
?>
<?php if ($shouldLoad): ?>
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.google-analytics.com" />
    <!-- Consent Mode v2: deny analytics storage by default, restore prior consent before GTM evaluates any tag -->
    <script nonce="<?= $cspNonce ?? '' ?>">
        window.dataLayer = window.dataLayer || [];

        function gtag() {
            dataLayer.push(arguments);
        }
        gtag('consent', 'default', {
            'analytics_storage': 'denied',
            'ad_storage': 'denied',
            'ad_user_data': 'denied',
            'ad_personalization': 'denied'
        });
        // Consent Mode gating contract: if window.OsmiumCookieConsent.cookieName is set by
        // whatever's on the page (no assumption about which service, if any, set it) and
        // that cookie reads 'accepted', grant analytics_storage. Silently does nothing if
        // no such global exists - this service works standalone either way.
        (function() {
            var cookieName = window.OsmiumCookieConsent && window.OsmiumCookieConsent.cookieName;
            if (!cookieName) return;
            var m = document.cookie.match(new RegExp('(?:^|; )' + cookieName + '=([^;]*)'));
            if (m && decodeURIComponent(m[1]) === 'accepted') {
                gtag('consent', 'update', {
                    'analytics_storage': 'granted'
                });
            }
        })();
        // Live update when a consent tool fires 'osmium:consent' (detail.value 'accepted' / 'rejected').
        document.addEventListener('osmium:consent', function(e) {
            gtag('consent', 'update', {
                'analytics_storage': e.detail && e.detail.value === 'accepted' ? 'granted' : 'denied'
            });
        });
    </script>
    <!-- Google Tag Manager (deferred until idle or first interaction) -->
    <script nonce="<?= $cspNonce ?? '' ?>">
        (function(w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({
                'gtm.start': new Date().getTime(),
                event: 'gtm.js'
            });
            var loaded = false;

            function load() {
                if (loaded) {
                    return;
                }
                loaded = true;
                var f = d.getElementsByTagName(s)[0],
                    j = d.createElement(s),
                    dl = l != 'dataLayer' ? '&l=' + l : '';
                j.async = true;
                j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
                f.parentNode.insertBefore(j, f);
                events.forEach(function(e) {
                    w.removeEventListener(e, load);
                });
                clearTimeout(idleTimer);
            }
            var events = ['scroll', 'click', 'keydown', 'touchstart', 'mousemove'];
            events.forEach(function(e) {
                w.addEventListener(e, load, {
                    passive: true,
                    once: true
                });
            });
            var idleTimer = setTimeout(load, 5000);
        })(window, document, 'script', 'dataLayer', '<?php echo \htmlspecialchars($gtmId, ENT_QUOTES); ?>');
    </script>
    <!-- End Google Tag Manager -->
<?php endif; ?>
